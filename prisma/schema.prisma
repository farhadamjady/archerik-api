// Cartograph persistence — JSONB-centric so the seeded demo dataset maps 1:1 to the API shapes.
// Mirrors CLAUDE.md §4. Extractor/scan tables (scans) are defined now but unused until P2.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A single immutable scan result for (repo, branch, commit). `data` holds { teams, nodes, edges }.
model Graph {
  id        String   @id @default(uuid()) @db.Uuid
  repo      String
  branch    String
  commitSha String   @map("commit_sha") @db.VarChar(40)
  scannedAt DateTime @map("scanned_at")
  data      Json     @db.JsonB

  contracts Contract[]
  commits   Commit[]

  @@unique([repo, branch, commitSha])
  @@index([repo, branch, scannedAt])
  @@map("graphs")
}

/// One row per REST endpoint or Kafka topic. `data` holds the full contract object.
model Contract {
  id      String @id @default(uuid()) @db.Uuid
  graphId String @map("graph_id") @db.Uuid
  kind    String // 'rest' | 'kafka'
  data    Json   @db.JsonB

  graph Graph @relation(fields: [graphId], references: [id], onDelete: Cascade)

  @@index([graphId, kind])
  @@map("contracts")
}

/// Architecture-relevant commit with its graph diff. `changes` holds the change records array.
model Commit {
  id          String   @id @default(uuid()) @db.Uuid
  graphId     String   @map("graph_id") @db.Uuid
  commitSha   String   @map("commit_sha") @db.VarChar(40)
  authorName  String   @map("author_name")
  authorHandle String? @map("author_handle")
  authorEmail String?  @map("author_email")
  message     String
  pr          String?
  branch      String?
  when        DateTime
  changes     Json     @db.JsonB

  graph Graph @relation(fields: [graphId], references: [id], onDelete: Cascade)

  @@index([graphId, when])
  @@map("commits")
}

/// An application user. Password is stored as a bcrypt hash; never returned to clients.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  handle       String
  team         String
  createdAt    DateTime @default(now()) @map("created_at")

  sessions Session[]

  @@map("users")
}

/// An opaque bearer session. `tokenHash` = sha256(token) so a DB dump can't be replayed.
/// Logout sets `revokedAt` — this is why tokens are DB-backed and not self-contained JWTs.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// A control-plane tenant the extractor submits under. Carries the entitlement the extractor's
/// `/v1/auth/validate` gate decodes (plan/quota/expiry). Quota is a placeholder int for now.
model Account {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  plan           String   @default("mvp")
  quotaRemaining Int      @default(1000000) @map("quota_remaining")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  apiKeys   ApiKey[]
  baselines ServiceBaseline[]

  @@map("accounts")
}

/// An extractor API key. Stored as sha256(key) so a DB dump can't be replayed. Sent as
/// `Authorization: Bearer <key>` on both /v1/auth/validate and /v1/ingest.
model ApiKey {
  id        String    @id @default(uuid()) @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  keyHash   String    @unique @map("key_hash")
  label     String?
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("api_keys")
}

/// The stored per-service baseline for diffing. `body` holds the extractor's byte-stable Service
/// JSON VERBATIM (raw bytes) — the "unchanged" fast path is bytes.Equal(body, incoming), so we must
/// never re-marshal. One baseline per (account, service_id, default_branch).
model ServiceBaseline {
  id            String   @id @default(uuid()) @db.Uuid
  accountId     String   @map("account_id") @db.Uuid
  serviceId     String   @map("service_id")
  serviceName   String?  @map("service_name")
  defaultBranch String   @map("default_branch")
  sha           String?  @db.VarChar(40)
  body          Bytes
  updatedAt     DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, serviceId, defaultBranch])
  @@index([accountId])
  @@map("service_baselines")
}

/// Scan jobs (P2). Present for schema completeness; not used by the P0 API.
model Scan {
  id          String    @id @default(uuid()) @db.Uuid
  repo        String
  branch      String
  status      String // 'queued' | 'in_progress' | 'complete' | 'failed'
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  results     Json?     @db.JsonB
  error       String?

  @@map("scans")
}
