# Copy to .env for local development.
# Matches the docker-compose Postgres service.
DATABASE_URL="postgresql://archerik:archerik@localhost:5432/archerik?schema=public"

# HTTP port the Nest app listens on.
PORT=3000

# Comma-separated list of allowed CORS origins for the UI (use * to allow all in dev).
CORS_ORIGINS=*

# --- Sessions ---
# Session lifetime in hours (default 168 = 7 days).
SESSION_TTL_HOURS=168
# Where the SSO callback lands the browser after minting a token.
APP_URL=http://localhost:5173

# --- SSO (OIDC) ---
# This backend's externally reachable base URL. Used to build the fixed OIDC redirect_uri
# (${BACKEND_PUBLIC_URL}/api/v1/auth/sso/callback) every tenant's IdP registers — distinct from
# APP_URL, which is the frontend's URL. No default: must be set explicitly per environment.
BACKEND_PUBLIC_URL=http://localhost:3000
# 32-byte base64 key (generate with `openssl rand -base64 32`) used to encrypt each SsoConnection's
# OIDC client secret at rest (AES-256-GCM). No default — the app fails closed if this is unset,
# since a shipped default key would let anyone decrypt every tenant's client secret.
SSO_ENCRYPTION_KEY=
# How long an in-flight SSO login (state/nonce/PKCE) stays valid before it must be retried.
SSO_STATE_TTL_MINUTES=10

# --- LLM provider keys (Ask tab, bring-your-own-key) ---
# 32-byte base64 key (generate with `openssl rand -base64 32`) used to encrypt each account's
# Anthropic/OpenAI API key at rest (AES-256-GCM, same scheme as SSO_ENCRYPTION_KEY). Deliberately a
# SEPARATE key from SSO_ENCRYPTION_KEY so one leaked key doesn't unlock both classes of secret.
# No default — the app fails closed if this is unset.
LLM_ENCRYPTION_KEY=
# Whether PUT /settings/llm-keys validates a key against the provider before storing it (an
# auth-only call that spends no tokens). Defaults to on. Set to `false` for offline development and
# CI, where there is no egress — otherwise every key save fails with "couldn't reach <provider>".
LLM_VERIFY_KEYS=true
# Per-request timeout for provider calls, in milliseconds. Ask is interactive, so this should stay
# well under whatever your proxy/load balancer allows. Default 60000.
LLM_REQUEST_TIMEOUT_MS=60000
