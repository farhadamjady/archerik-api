# Copy to .env for local development.
# Matches the docker-compose Postgres service.
DATABASE_URL="postgresql://cartograph:cartograph@localhost:5432/cartograph?schema=public"

# HTTP port the Nest app listens on.
PORT=3000

# Comma-separated list of allowed CORS origins for the UI (use * to allow all in dev).
CORS_ORIGINS=*

# --- Auth (P1) ---
# Session lifetime in hours (default 168 = 7 days).
SESSION_TTL_HOURS=168
# Where GET /auth/sso lands the browser after minting a token.
APP_URL=http://localhost:5173
# Email used for the SSO stub's demo account.
SSO_DEMO_EMAIL=sso@acme.com
